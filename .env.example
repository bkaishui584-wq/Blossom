# 复制为 .env 后按需修改。.env 不进入 Git。
# 打包成 DeskPet.exe 后：程序与这份 .env 放在一起，数据默认写到
# %LOCALAPPDATA%\DeskPet（想改位置就设置 DESKPET_ROOT）。
# 开发模式下数据仍在项目目录里，位置不变。
DESKPET_DATA_DIR=./data
DESKPET_LOG_DIR=./logs
DESKPET_DB_PATH=./data/deskpet.sqlite3
DESKPET_LOG_LEVEL=INFO
DESKPET_DEV_MODE=0

# 模型：推荐在应用里配置（设置 → 模型 → 模型与 API 管理）。
# 那里会用 Windows DPAPI 加密保存 Key，并按服务商/用途管理多套配置。
# 下面这些环境变量仍然兼容，只在应用里没配时作为回退；不要把真实 Key 写进这个模板文件。
DESKPET_LLM_PROVIDER=openai-compatible
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_TIMEOUT=60

# 双模型：陪伴模型负责聊天，任务模型只在真正执行任务时使用。
# 上面那套 AGENT_LLM_* 仍然兼容，会自动作为陪伴模型的 fallback。
# 陪伴模型（留空则用 AGENT_LLM_*）
DESKPET_COMPANION_BASE_URL=
DESKPET_COMPANION_API_KEY=
DESKPET_COMPANION_MODEL=
# 任务模型（不配置也能正常聊天，只是不能执行任务）
DESKPET_TASK_BASE_URL=
DESKPET_TASK_API_KEY=
DESKPET_TASK_MODEL=
# 代理（可选，只影响模型请求）与重试次数（0-2）
DESKPET_LLM_PROXY=
DESKPET_LLM_RETRIES=1
# 需要动手的任务必须先确认。1=开启（默认），0=关闭
DESKPET_TASK_CONFIRM=1

# 上下文与记忆预算：控制每轮发给模型的量。
DESKPET_CONTEXT_BUDGET=2000
# 近期候选消息条数：20-30 起步，再按真实 token 预算裁剪。
DESKPET_RECENT_WINDOW=24
# 每轮检索多少条相关记忆（和总存储量分开）。
DESKPET_MEMORY_LIMIT=12
DESKPET_SUMMARY_TRIGGER=24
DESKPET_SUMMARY_MAX_CHARS=600
# 记忆容量上限：超出只归档最旧最不重要的，不删除；锁定项不受限。
DESKPET_MEMORY_CAPACITY=2000

# 主动陪伴：默认开启，只在规则命中时触发，不做模型轮询。
DESKPET_PROACTIVE=1
DESKPET_WORK_REMINDER_SECONDS=3600
# 用户阀门：0 表示不加额外限制，只会让桌宠更安静。界面里改的是偏好，重启后仍然算数。
DESKPET_PROACTIVE_COOLDOWN=0
DESKPET_PROACTIVE_MAX_PER_DAY=0

# 人格：名字与性格强度。性格只影响表达方式，不影响权限判断。
# 可用性格：温柔 理性 活泼 安静 幽默 好奇 认真 独立 傲娇，强度 0-100。
# 界面里调过的强度会存进偏好，优先于这里的配置。
DESKPET_PERSONA_NAME=小蝶
DESKPET_PERSONA_TRAITS=

# 外部服务。天气用 Open-Meteo，无需密钥。
# 新闻需要密钥（NewAPI 兼容），未配置时新闻服务会如实报不可用。
DESKPET_WEATHER_CITY=
DESKPET_NEWS_API_KEY=
DESKPET_NEWS_BASE_URL=
DESKPET_SERVICE_CACHE_TTL=600

# 外部设备：真机默认拒绝。串口设备要打开这个开关，并在下面的设备清单里写上端口，
# 才会真的去连；保持为 0 时只跑模拟设备。
DESKPET_ALLOW_REAL_DEVICES=0

# 角色包：自己准备的人格与形象资料放在这里，目录里有几包就有几只宠物。
DESKPET_CHARACTERS_DIR=
DESKPET_CHARACTER=

# Live2D：模型由你自己准备，程序不下载、不制作模型。
# 放法：live2d/<名字>/<名字>.model3.json（目录默认在用户数据目录下）
# 模型没放或渲染器没装时，桌宠继续用占位形象，不会报错。
DESKPET_LIVE2D_DIR=
DESKPET_LIVE2D_MODEL=
# 画面开关：给 0 就完全不起角色窗口，只用占位形象（默认 1）。
DESKPET_LIVE2D_RENDER=1
# 角色首发大小（像素，80-1200）与缩放倍数（0.2-4.0）。
DESKPET_LIVE2D_HEIGHT=320
DESKPET_LIVE2D_SCALE=1.0
# 只在调试渲染器时才用：换一套渲染资源目录。平时留空。
DESKPET_LIVE2D_RUNTIME=

# 设备清单：把自己的外设写进 devices/devices.json 就会被认出来。
# esp32 条目写了 options.port 才会去开真串口，而且要先打开上面的总开关；
# 没写端口就还是内存里的模拟设备。网络传输还没实现。
DESKPET_DEVICES_DIR=

# 语音输出：默认关闭。开了就用系统自带朗读念出桌宠的话，不联网、不加依赖。
# 语速 -10 到 10，音量 0 到 100。
DESKPET_VOICE_OUTPUT=0
DESKPET_VOICE_RATE=0
DESKPET_VOICE_VOLUME=100
# 语音包：自己准备的语音包放这里，一个子目录一个包，包内是 voicepack.json。
# 导入只登记元数据（名称、版本、引擎），不复制也不执行包里的任何文件。
DESKPET_VOICES_DIR=

# 语音输入：程序不下载、不安装任何识别引擎。你自己装好再填这里就能用。
# 引擎名例如 sherpa-onnx 或 vosk；模型目录填本地已下载好的模型路径。留空就是不可用。
# 用 sherpa-onnx 时的模型布局（目录里要有 tokens.txt）：
#   whisper      <名字>-encoder.onnx + <名字>-decoder.onnx
#   sense_voice  model.onnx 或 model.int8.onnx
#   paraformer   model.onnx 或 model.int8.onnx
# 认不出就按 sense_voice -> paraformer -> whisper 逐个试，成功哪个会在状态里如实报出来。
DESKPET_STT_ENGINE=
DESKPET_STT_MODEL=
# 模型是哪一种：auto（默认，按目录名和文件名认）/ sense_voice / paraformer / whisper
DESKPET_STT_KIND=auto
# 识别语言，留空按引擎默认。例：zh、en、auto（SenseVoice 支持）
DESKPET_STT_LANGUAGE=
# 录音落盘位置，默认在数据目录下的 recordings/。只在按下录音时写一个 wav。
DESKPET_RECORDINGS_DIR=

# 托盘图标默认开；系统不给托盘就安静降级，不影响桌宠启动。
DESKPET_TRAY=1

# 全局快捷键默认不占用，例：ctrl+alt+d
DESKPET_HOTKEY=

